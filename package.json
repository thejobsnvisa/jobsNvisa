{
  "name": "jobsNvisa",
  "homepage": "https://jobsnvisa.com.au",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate-routes": "node Scripts/generateRoutes.cjs",
    "generate-static-pages": "node Scripts/generateStaticPages.cjs",
    "build": "npx shx rm -rf dist && vite build && npm run generate-routes && npm run generate-static-pages && npx react-snap && npm run sitemap",
    "preview": "vite preview",
    "sitemap": "node Scripts/script.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "reactSnap": {
    "source": "dist",
    "inlineCss": false,
    "skipThirdPartyRequests": true,
    "concurrency": 1,
    "delay": 1000,
    "executionTimeLimit": 45000,
    "crawl": false,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-dev-shm-usage",
      "--disable-gpu",
      "--disable-gl-drawing-for-tests"
    ],
    "include": [
      "/",
      "/blogs/",
      "/blogs/how-jobs-n-visa-connects-employers-with-skilled-global-talent/",
      "/blogs/your-complete-guide-to-australian-visa-pr-pathways/",
      "/blogs/your-guide-to-moving-to-australia-as-a-nurse/",
      "/brochures/",
      "/cookie-policy/",
      "/employee-services/",
      "/healthcare/",
      "/help-center/",
      "/job-search/",
      "/privacy-policy/",
      "/recruiters/",
      "/recruiters-services/",
      "/terms/"
    ]
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-icon": "^1.0.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.16.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sitemap": "^9.0.1",
    "swiper": "^12.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "finalhandler": "^2.1.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.15",
    "puppeteer": "^25.5.0",
    "react-snap": "^1.23.0",
    "rimraf": "^6.1.3",
    "serve-static": "^2.2.1",
    "shx": "^0.4.0",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.12",
    "vite-node": "^6.0.0"
  }
}
